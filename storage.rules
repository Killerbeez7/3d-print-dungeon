rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn()   { return request.auth != null; }
    function isAdmin()      { return isSignedIn() && (request.auth.token.admin == true || request.auth.token.super == true); }

    // Public model media: viewer files, renders, posters. Original files used to
    // live in models/original; nobody reads them directly any more.
    match /models/{folder}/{allPaths=**} {
      allow read: if folder != "original";
      allow create: if isSignedIn() && folder != "original" && resource == null;
      allow update, delete: if isAdmin();
    }

    // Original (printable) model files. Only the uploader can add them and no
    // browser can read them; downloads go through the getModelDownloadUrl
    // function, which checks for a purchase and returns a short-lived link.
    match /private/originals/{ownerId}/{allPaths=**} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.auth.uid == ownerId
        && resource == null
        && request.resource.size < 500 * 1024 * 1024;
      allow update, delete: if false;
    }

    // User uploads folder
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Profile pictures
    match /profiles/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
  }
}
